{
  "type": "object",
  "required": [
    "id", "title", "summary", "estimated_minutes",
    "characters", "locations", "location_pool", "items",
    "true_culprit_character_id", "allow_private_talk", "round_count"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "maxLength": 4 },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "round_count": { "type": "integer", "minimum": 2 },
    "allow_private_talk": { "type": "boolean" },
    "true_culprit_character_id": { "type": "string", "minLength": 1 },
    "characters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "location_pool": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "origin_location_id": { "type": "string" }
        }
      }
    }
  }
}
